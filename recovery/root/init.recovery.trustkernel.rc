# TrustKernel TEE + KeyMint 3.0 + Gatekeeper for FBE/metadata decryption
# in OrangeFox on OSCAL TANK 1 (MT6877). Mirrors /vendor/etc/init/trustkernel.rc.

on init
    mkdir /mnt/vendor 0755 root root
    mkdir /mnt/vendor/persist 0771 system system
    mkdir /mnt/vendor/protect_f 0771 system system
    mkdir /mnt/vendor/protect_s 0771 system system
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw

on fs
    wait /dev/block/by-name/persist
    mount ext4 /dev/block/by-name/persist /mnt/vendor/persist noatime nosuid nodev
    mount ext4 /dev/block/by-name/protect1 /mnt/vendor/protect_f noatime nosuid nodev
    mkdir /mnt/vendor/persist/t6 0770 system system
    mkdir /mnt/vendor/protect_f/tee 0770 system system

on post-fs
    # /data is not decrypted yet: the TEE secure file system lives in RAM here,
    # the real keys are taken from RPMB / persist / protect_f.
    mkdir /data/vendor 0771 system system
    mkdir /data/vendor/t6 0770 system system
    mkdir /data/vendor/t6/fs 0770 system system
    mkdir /data/vendor/t6/app 0770 system system
    setprop vendor.trustkernel.fs.mode 1
    setprop vendor.trustkernel.fs.state ready
    start teed

on property:vendor.trustkernel.ready=true
    start vendor.keymint-3-0-trustkernel
    start vendor.gatekeeper

service teed /vendor/bin/teed \
    --tzdev /dev/tkcore_admin \
    --datapath /data/vendor/t6/fs \
    --sptapath /data/vendor/t6/app \
    --systapath /vendor/app/t6 \
    --rpmbdev /dev/mmcblk0rpmb \
    --rpmbdev /dev/rpmb0 \
    --prot /mnt/vendor/persist/t6 \
    --prot /mnt/vendor/protect_f/tee \
    --prebuilt /vendor/app/t6/data \
    --logpath /tmp/tkcore.log \
    --proprefix vendor.trustkernel
    user root
    group root system
    capabilities SYS_RAWIO
    seclabel u:r:recovery:s0
    disabled

service vendor.keymint-3-0-trustkernel /vendor/bin/hw/android.hardware.security.keymint@3.0-service.trustkernel
    user root
    group root system
    seclabel u:r:recovery:s0
    disabled

service vendor.gatekeeper /vendor/bin/hw/android.hardware.gatekeeper-service.trustkernel
    user root
    group root system
    seclabel u:r:recovery:s0
    disabled
